\procedure conference-session(tiddler)
	<$macrocall
		$name="stretch-template"
		tiddler=<<tiddler>>
		smallTemplate="$:/tzk/Templates/Topical/ConferenceSessionStretch"
		largeTemplate="$:/tzk/Templates/General/IdentityTemplate"
	/>
\end conference-session