created: 20240601142205284
creator: soren
description: Show an image floated to the side of the text of a tiddler. This widget is often used with the `clarify` macro, which forces further content to come after the float.
example: <$m2.float source="freezer-example.jpg" width=200 side="left" />Text on the right side of the float.<<clarify>>
modified: 20251011162015418
modifier: soren
tags: $:/tags/Global
title: $:/tzk/Widgets/float
type: text/vnd.tiddlywiki

\widget $m2.float(source, width:"400", side:"right", caption:"")
  <div class=`$(side)$-float`>
		<$image source=<<source>> width=<<width>>/>
		<% if [<caption>!is[blank]] %><br><div style="text-align: center; font-style: italic; margin-bottom: 1ex;"><<caption>></div><% endif %>
	</div>
\end