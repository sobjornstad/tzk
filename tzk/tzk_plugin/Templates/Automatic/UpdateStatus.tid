title: $:/tzk/Templates/Automatic/UpdateStatus
type: text/vnd.tiddlywiki

\whitespace trim

\procedure mark-ok() <$action-setfield $timestamp="no" reviewed=<<now "YYYY0MM0DD">>/>

<!-- The rule itself lives in $:/tzk/Functions/staleness, shared with
     $:/tzk/Tools/StaleIdeas and the Reference Explorer. That function
     distinguishes "flagged" from "out-of-date"; here both read as "stale". -->

<!-- transcluded in $:/core/ui/ViewTemplate/subtitle -->
<% if [all[current]tag[Idea]] %>
	&nbsp;
	<$let updateStatus={{{ [function[m2.update-status],<currentTiddler>] }}}>
		(
		<% if [<updateStatus>match[frozen]] %>
			<$link to="UpdateStatuses">
				<span style='color: blue;'>frozen</span>
			</$link>
		<% elseif [<updateStatus>match[maintained]] %>
			<$link to="UpdateStatuses"><span style='color: green;'>maintained</span></$link>
		<% else %>
			<$link to="UpdateStatuses">
				<span style='color: tomato;'>stale</span>
			</$link>
			<% if [m2.ff[MarkStaleUpdated]] %>
				;&nbsp;
				<$button class="tc-tiddlylink tc-btn-invisible" actions=<<mark-ok>>>reup?</$button>
			<% endif %>
		<% endif %>
		)
	</$let>

<% endif %>